{
  "lich": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/report-session-start.sh\" antigravity",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/report-state.sh\" busy",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/report-tool.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/report-touched.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/report-state.sh\" done",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/report-title.sh\"",
        "timeout": 5
      }
    ]
  }
}
